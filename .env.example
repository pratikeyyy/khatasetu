# KhataSetu Environment Variables

# Application
APP_NAME=KhataSetu
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
# Local SQLite for zero-cost development:
DATABASE_URL=sqlite:///./khatasetu.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/khatasetu

# Security & Authentication
JWT_SECRET=replace_with_a_super_secret_jwt_key_minimum_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# AI / Vision Pipeline
# Free Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# Leave blank to run in offline mock demo mode:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OCR Confidence Thresholds (0.0 to 1.0)
CONFIDENCE_HIGH_THRESHOLD=0.95
CONFIDENCE_REVIEW_THRESHOLD=0.80

# Storage
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10

# Firebase (Optional for frontend Google Auth & Push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
